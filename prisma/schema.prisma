generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String           @id @default(uuid())
  email                    String
  phone                    String?
  name                     String
  role                     Role             @default(CUSTOMER)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  address                  String?
  dob                      DateTime?
  bookingNotifications     Boolean          @default(true)
  image                    String?
  marketingNotifications   Boolean          @default(true)
  messageNotifications     Boolean          @default(true)
  otpNotifications         Boolean          @default(true)
  favoriteServices         String[]         @default([])
  fontSize                 String           @default("medium")
  highContrast             Boolean          @default(false)
  language                 String           @default("en")
  locationSharing          Boolean          @default(true)
  preferredCategories      String[]         @default([])
  profileVisible           Boolean          @default(true)
  promotionalNotifications Boolean          @default(true)
  reducedAnimations        Boolean          @default(false)
  reviewNotifications      Boolean          @default(true)
  showOnlineStatus         Boolean          @default(true)
  systemNotifications      Boolean          @default(true)
  theme                    String           @default("light")
  walletBalance            Float            @default(5000.0)
  fcmToken                 String?
  bookings                 Booking[]        @relation("CustomerBookings")
  cartItems                CartItem[]       @relation("UserCart")
  conversationsAsUser      Conversation[]   @relation("ConversationUser")
  messagesSent             Message[]        @relation("MessagesSent")
  notifications            Notification[]   @relation("UserNotifications")
  orders                   Order[]          @relation("UserOrders")
  payments                 Payment[]        @relation("CustomerPayments")
  reviewsGiven             Review[]         @relation("ReviewsGiven")
  savedWorkers             SavedWorker[]    @relation("CustomerSavedWorkers")
  serviceRequests          ServiceRequest[] @relation("CustomerRequests")
  transactions             Transaction[]    @relation("UserTransactions")
  wishlistItems            WishlistItem[]   @relation("UserWishlist")
  workerProfile            WorkerProfile?

  @@unique([email, role])
  @@index([role])
}

model WorkerProfile {
  id                    String         @id @default(uuid())
  userId                String         @unique
  skills                String[]
  experience            Int
  isOnline              Boolean        @default(false)
  hourlyRate            Float?
  rating                Float          @default(0.0)
  totalReviews          Int            @default(0)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  categoryId            String?
  locationAddress       String?
  locationLat           Float?
  locationLng           Float?
  locationId            String?        @unique
  customProfession      String?
  userType              String?        @default("worker")
  profession            String[]
  availabilityStatus    String?        @default("AVAILABLE")
  languages             String[]       @default([])
  portfolio             String[]       @default([])
  workingHours          String?        @default("9:00 AM - 5:00 PM")
  paymentPreference     String         @default("BANK_TRANSFER")
  serviceAreas          String[]       @default([])
  serviceAvailability   Boolean        @default(true)
  jobs                  Booking[]      @relation("WorkerBookings")
  conversationsAsWorker Conversation[] @relation("ConversationWorker")
  payments              Payment[]      @relation("WorkerPayments")
  reviews               Review[]       @relation("WorkerReviews")
  savedBy               SavedWorker[]  @relation("WorkerSavedBy")
  category              Category?      @relation(fields: [categoryId], references: [id])
  location              Location?      @relation(fields: [locationId], references: [id])
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([isOnline])
}

model SavedWorker {
  id         String        @id @default(uuid())
  customerId String
  workerId   String
  createdAt  DateTime      @default(now())
  customer   User          @relation("CustomerSavedWorkers", fields: [customerId], references: [id], onDelete: Cascade)
  worker     WorkerProfile @relation("WorkerSavedBy", fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([customerId, workerId])
}

model Category {
  id          String          @id @default(uuid())
  name        String          @unique
  icon        String
  description String?
  workers     WorkerProfile[]
}

model Location {
  id      String         @id @default(uuid())
  lat     Float
  lng     Float
  address String?
  worker  WorkerProfile?
}

model Booking {
  id                  String        @id @default(uuid())
  customerId          String
  workerId            String
  status              BookingStatus @default(PENDING)
  jobDetails          String
  price               Float?
  scheduledAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  completionImage     String?
  category            String        @default("General")
  voiceUrl            String?
  priority            String        @default("NORMAL")
  chatEnabled         Boolean       @default(false)
  contactShared       Boolean       @default(false)
  workerAcceptedAt    DateTime?
  customerConfirmedAt DateTime?
  customer            User          @relation("CustomerBookings", fields: [customerId], references: [id])
  worker              WorkerProfile @relation("WorkerBookings", fields: [workerId], references: [id])
  payment             Payment?

  @@index([customerId])
  @@index([customerId, updatedAt])
  @@index([workerId])
  @@index([workerId, updatedAt])
  @@index([status])
}

model Review {
  id         String        @id @default(uuid())
  rating     Int
  comment    String?
  reviewerId String
  workerId   String
  createdAt  DateTime      @default(now())
  reviewer   User          @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  worker     WorkerProfile @relation("WorkerReviews", fields: [workerId], references: [id])
}

model Conversation {
  id         String        @id @default(uuid())
  customerId String
  workerId   String
  updatedAt  DateTime      @updatedAt
  createdAt  DateTime      @default(now())
  customer   User          @relation("ConversationUser", fields: [customerId], references: [id])
  worker     WorkerProfile @relation("ConversationWorker", fields: [workerId], references: [id])
  messages   Message[]

  @@unique([customerId, workerId])
  @@index([updatedAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessagesSent", fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@index([conversationId, isRead, senderId])
  @@index([senderId])
  @@index([isRead])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  category  String           @default("SYSTEM")
  relatedId String?
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model ServiceRequest {
  id                String        @id @default(uuid())
  customerId        String
  category          String
  description       String
  budget            Float?
  status            RequestStatus @default(OPEN)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  assignedWorkerId  String?
  latitude          Float?
  longitude         Float?
  rejectedWorkerIds String[]      @default([])
  media             Media[]
  customer          User          @relation("CustomerRequests", fields: [customerId], references: [id])
}

model Media {
  id               String         @id @default(uuid())
  url              String
  type             MediaType
  serviceRequestId String
  createdAt        DateTime       @default(now())
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String         @id @default(uuid())
  amount        Float
  platformFee   Float          @default(25.0)
  tax           Float          @default(0.0)
  totalAmount   Float
  status        PaymentStatus  @default(PENDING)
  method        PaymentMethod?
  transactionId String?
  bookingId     String         @unique
  customerId    String
  workerId      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  invoice       Invoice?
  booking       Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer      User           @relation("CustomerPayments", fields: [customerId], references: [id])
  worker        WorkerProfile  @relation("WorkerPayments", fields: [workerId], references: [id])
}

model Invoice {
  id            String      @id @default(uuid())
  invoiceNumber String      @unique
  date          DateTime    @default(now())
  totalAmount   Float
  paymentId     String      @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  emailAttempts Int         @default(0)
  emailSentAt   DateTime?
  emailStatus   EmailStatus @default(PENDING)
  htmlContent   String?
  payment       Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Product {
  id             String         @id @default(uuid())
  name           String
  description    String?
  price          Float
  image          String?
  rating         Float          @default(4.5)
  stock          Int            @default(10)
  category       String
  sellerName     String         @default("Natural Care")
  sellerLocation String         @default("Chennai, India")
  createdAt      DateTime       @default(now())
  cartItems      CartItem[]
  orderItems     OrderItem[]
  wishlistItems  WishlistItem[]
}

model Order {
  id          String      @id @default(uuid())
  customerId  String
  totalAmount Float
  status      String      @default("PROCESSING")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  customer    User        @relation("UserOrders", fields: [customerId], references: [id])
  items       OrderItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model WishlistItem {
  id         String   @id @default(uuid())
  customerId String
  productId  String
  createdAt  DateTime @default(now())
  customer   User     @relation("UserWishlist", fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
}

model CartItem {
  id         String   @id @default(uuid())
  customerId String
  productId  String
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  customer   User     @relation("UserCart", fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  amount      Float
  type        String
  description String
  createdAt   DateTime @default(now())
  user        User     @relation("UserTransactions", fields: [userId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum Role {
  CUSTOMER
  WORKER
  ADMIN
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  AWAITING_PAYMENT
  PAYMENT_COMPLETED
}

enum RequestStatus {
  OPEN
  MATCHED
  CLOSED
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum PaymentMethod {
  UPI
  DEBIT_CARD
  CREDIT_CARD
  NET_BANKING
  WALLET
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}
